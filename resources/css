    .home-description { max-width: 390px; font-size: 14px; }
    .section { padding: 65px 0; }
    .catalog-page { padding-top: 102px; }
    .catalog-toolbar { gap: 12px; }
    .equipment-grid { grid-template-columns: 1fr; gap: 13px; }
    .equipment-image { height: 220px; }
    .equipment-info { padding: 14px; }
    .footer-inner { align-items: start; flex-direction: column; justify-content: center; gap: 10px; padding-block: 25px; }
    .footer-inner > p { margin: 4px 0; font-size: 14px; }
    .footer-contact { align-items: start; }
    .page-hero { padding: 125px 0 42px; }
    .page-hero h1 { font-size: 42px; }
    .detail-section { padding-top: 30px; }
    .detail-grid { grid-template-columns: 1fr; gap: 25px; }
    .detail-image { height: 275px; }
    .detail-description { padding-top: 24px; }
    .detail-description h2 { font-size: 30px; }
    .booking-card { padding: 18px; }
    .auth-page { grid-template-columns: 1fr; padding-top: 70px; }
    .auth-aside { min-height: 280px; padding: 47px 26px; }
    .auth-aside h1 { margin-block: 14px 7px; font-size: 48px; }
    .auth-aside > p { max-width: 320px; font-size: 11px; }
    .auth-panel { width: calc(100% - 44px); padding: 36px 0 52px; }
    .auth-panel .back-link { margin-bottom: 26px; }
    .dashboard-section { padding-top: 35px; }
    .dashboard-title { align-items: start; flex-direction: column; }
    .dashboard-title h2 { font-size: 31px; }
    .profile-section { padding-top: 30px; }
    .profile-form { grid-template-columns: 1fr; padding: 18px; }
    .profile-form .profile-address { grid-column: auto; }
    .rental-card-head { align-items: start; gap: 10px; padding: 13px; }
    .rental-card-body { grid-template-columns: 1fr; gap: 16px; padding: 14px; }
    .rental-facts { grid-template-columns: 1fr 1fr; padding-top: 13px; border-top: 1px solid var(--line); }
    .rental-card-foot { align-items: start; flex-direction: column; padding: 12px 14px; }
    .rental-actions { width: 100%; align-items: start; flex-wrap: wrap; }
    .inline-return-form { flex-wrap: wrap; }
    .inline-action-form { right: auto; left: 0; }
    .admin-section { padding-top: 6px; }
    .admin-nav { top: 70px; gap: 17px; }
    .admin-stats { grid-template-columns: 1fr 1fr; gap: 7px; }
