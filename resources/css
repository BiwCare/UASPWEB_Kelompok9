    --muted: #788078;
    --line: #e4e6dc;
    --white: #fff;
    --serif: Georgia, 'Times New Roman', serif;
    font-family: var(--font-sans);
    color: var(--ink);
    background: #101711;
    font-synthesis: none;
    text-rendering: optimizeLegibility;
}

* { box-sizing: border-box; }
html { scroll-behavior: smooth; scroll-padding-top: 100px; }
