    .main-nav { position: absolute; top: 70px; right: 0; left: 0; display: none; align-items: stretch; gap: 0; padding: 7px 18px 17px; color: white; background: rgba(0, 0, 0, .82); box-shadow: 0 10px 20px rgba(0,0,0,.2); backdrop-filter: blur(12px); }
