    .admin-rental-summary, .admin-simple-row { align-items: start; flex-direction: column; }
    .admin-rental-right { justify-items: start; }
    .admin-inline-form { justify-content: start; flex-wrap: wrap; }
    .admin-inline-form input { flex: 1 1 100%; max-width: none; }
    .admin-forms-grid { grid-template-columns: 1fr; }
    .admin-forms-grid .admin-form-card:nth-child(2), .admin-forms-grid .admin-form-card:nth-child(3) { grid-row: auto; grid-column: auto; }
    .admin-row-actions { flex-wrap: wrap; }
    .return-review-form { width: 100%; }
    .service-section-grid { grid-template-columns: 1fr; }
    .settings-form { grid-template-columns: 1fr; }
}

@media (prefers-reduced-motion: reduce) {
    *, *::before, *::after { scroll-behavior: auto !important; animation-duration: .01ms !important; transition-duration: .01ms !important; }
}
