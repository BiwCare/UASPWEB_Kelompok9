.admin-rental-summary h3 span { margin-left: 7px; color: var(--muted); font-size: 9px; font-weight: 500; }
.admin-rental-tools { display: flex; flex-wrap: wrap; gap: 5px; }
.admin-rental-tools span { padding: 4px 7px; color: #657264; background: #f1f3eb; font-size: 8px; }
.admin-rental-right { display: grid; justify-items: end; gap: 4px; }
.admin-rental-right > strong { font-size: 11px; }
.admin-rental-right > small { color: var(--muted); font-size: 9px; }
.admin-inline-form { display: flex; justify-content: flex-end; gap: 7px; margin-top: 11px; }
.admin-inline-form input { max-width: 230px; min-height: 35px; }
.admin-inline-form select { width: 145px; min-height: 35px; }
.admin-simple-row { padding: 15px 0; border-top: 1px solid var(--line); }
.admin-simple-row > div > p { margin: 3px 0 0; color: var(--muted); font-size: 9px; }
.admin-row-actions { display: flex; align-items: center; gap: 7px; }
.admin-row-actions form { margin: 0; }
.admin-empty { padding: 18px; color: var(--muted); background: #f8f9f4; font-size: 11px; text-align: center; }
.return-admin-row { align-items: start; }
.return-review-form { min-width: 200px; display: grid; gap: 8px; }
.return-review-form label { font-size: 9px; }
.return-review-form input, .return-review-form select { min-height: 34px; }
.admin-forms-grid { display: grid; grid-template-columns: 1fr 1.3fr 1fr; align-items: start; gap: 12px; }
.admin-form-card { display: grid; gap: 11px; padding: 15px; color: var(--ink); background: #fafbf7; border: 1px solid var(--line); }
.admin-form-card h3 { margin: 0; font-size: 13px; }
.admin-form-card input, .admin-form-card select { min-height: 36px; }
.admin-form-card textarea { min-height: 58px; }
.form-two-col { display: grid; grid-template-columns: 1fr 1fr; gap: 8px; }
.inventory-list { margin-top: 17px; border-top: 1px solid var(--line); }
.inventory-row { display: flex; align-items: center; justify-content: space-between; gap: 12px; padding: 10px 3px; border-bottom: 1px solid var(--line); }
.inventory-row strong, .inventory-row small { display: block; }
.inventory-row strong { font-size: 10px; }
.inventory-row small { margin-top: 3px; color: var(--muted); font-size: 9px; }
.inventory-row button { cursor: pointer; }
.service-section-grid { display: grid; grid-template-columns: .8fr 1.2fr; align-items: start; gap: 17px; }
.service-list { border-top: 1px solid var(--line); }
.service-row { display: flex; align-items: center; justify-content: space-between; gap: 12px; padding: 12px 0; border-bottom: 1px solid var(--line); }
.service-row h3 { margin: 5px 0 2px; font-size: 11px; }
.service-row p, .service-row small { display: block; margin: 0; color: var(--muted); font-size: 9px; }
.service-row small { margin-top: 4px; }
.service-warning { margin-top: 15px; padding: 12px; color: #805b16; background: #fbf3de; font-size: 10px; }
.settings-form { display: grid; grid-template-columns: repeat(2, 1fr); align-items: end; gap: 13px; }
.settings-form button { width: fit-content; }

@media (max-width: 980px) {
    .container, .footer-inner { width: min(100% - 44px, 780px); }
    .nav-shell { width: calc(100% - 44px); }
    .equipment-grid { grid-template-columns: repeat(2, 1fr); }
    .filter-pills { max-width: 100%; }
    .detail-grid { gap: 25px; }
    .detail-image { height: 340px; }
    .admin-forms-grid { grid-template-columns: 1fr 1fr; }
    .admin-forms-grid .admin-form-card:nth-child(2) { grid-row: span 2; grid-column: 2; }
    .admin-forms-grid .admin-form-card:nth-child(3) { grid-column: 1; }
}

