button, input, select, textarea { font: inherit; }
button, a { -webkit-tap-highlight-color: transparent; }
a { color: inherit; text-decoration: none; }
img { display: block; max-width: 100%; }
button { cursor: pointer; }
.container { width: min(1160px, calc(100% - 64px)); margin-inline: auto; }

.site-header { position: fixed; z-index: 50; inset: 0 0 auto; height: 82px; color: white; background: rgba(0, 0, 0, .58); box-shadow: 0 1px 0 rgba(255, 255, 255, .1); backdrop-filter: blur(12px); transition: background .25s, box-shadow .25s, color .25s, backdrop-filter .25s; }
