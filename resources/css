@theme {
    --font-sans: 'Instrument Sans', 'Segoe UI', sans-serif;
}

:root {
    --forest: #19382e;
    --forest-dark: #11291f;
    --leaf: #718b60;
    --lime: #cbd4b4;
    --paper: #f7f7f1;
    --cream: #eeeede;
